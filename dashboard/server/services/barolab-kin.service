[Unit]
Description=BaroLab request next KnowledgeIn publication conference
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/mnt/c/10_Project/BaroLab
Environment=DISPLAY=:10
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=%h/.venvs/barolab/bin/python3 -u -B -m common.conference_dispatch kin
TimeoutStartSec=30
UMask=0077
