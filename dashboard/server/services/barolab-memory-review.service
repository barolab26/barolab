[Unit]
Description=BaroLab durable Hermes memory review consumer
After=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Environment=PYTHONDONTWRITEBYTECODE=1
Type=simple
WorkingDirectory=/mnt/c/10_Project/BaroLab
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.venvs/barolab/bin/python3 dashboard/server/memory_worker.py
Restart=on-failure
RestartSec=10
KillMode=process
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=default.target
