[Unit]
Description=BaroLab CF current-day bounded publication worker
After=network-online.target

[Service]
Environment=PYTHONDONTWRITEBYTECODE=1
Type=oneshot
WorkingDirectory=/mnt/c/10_Project/BaroLab
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:10
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=%h/.venvs/barolab/bin/python3 cf_posting/posting.py --catch-up-today-once --limit 1
TimeoutStartSec=infinity
UMask=0077
