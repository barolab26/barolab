[Unit]
Description=BaroLab durable Hermes memory review consumer
After=network-online.target

[Service]
Environment=PYTHONDONTWRITEBYTECODE=1
Type=simple
WorkingDirectory=/mnt/c/10_Project/BaroLab
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.venvs/barolab/bin/python3 dashboard/runtime/memory_worker.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=infinity
UMask=0077

[Install]
WantedBy=default.target
