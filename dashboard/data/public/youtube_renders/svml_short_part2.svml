<?svml using="@hypit/markup@1"?>
<svml>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="spatial" from="@hypit/spatial@1"/>
  <import as="media" from="@hypit/media@1"/>
  <import as="mediaop" from="@hypit/media-operations@1"/>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="shorts" from="@barolab/shorts-scene@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="style" source="./look.svs"/>

  <time:Clock id="clock" frame-rate="30"/>
  <time:Timeline id="animation" clock={clock} end="1715f">
    <time:Instant id="beat-compare" at="351f"/>
    <time:Instant id="beat-steps" at="680f"/>
    <time:Instant id="step-1-at" at="680f"/>
    <time:Instant id="step-2-at" at="856f"/>
    <time:Instant id="step-3-at" at="1000f"/>
    <time:Instant id="beat-rule" at="1166f"/>
    <time:Instant id="beat-closing" at="1500f"/>
    <time:Instant id="cap-0-at" at="6f"/>
    <time:Instant id="cap-1-at" at="151f"/>
    <time:Instant id="cap-2-at" at="351f"/>
    <time:Instant id="cap-3-at" at="477f"/>
    <time:Instant id="cap-4-at" at="680f"/>
    <time:Instant id="cap-5-at" at="856f"/>
    <time:Instant id="cap-6-at" at="1000f"/>
    <time:Instant id="cap-7-at" at="1166f"/>
    <time:Instant id="cap-8-at" at="1321f"/>
    <time:Instant id="cap-9-at" at="1500f"/>
  </time:Timeline>

  <spatial:Canvas id="canvas" width="1080" height="1920"/>

  <media:Font id="kr-bold-face" src="./assets/malgunbd.ttf" weight="700" style="normal"/>
  <media:Font id="kr-reg-face" src="./assets/malgun.ttf" weight="400" style="normal"/>
  <media:FontStack id="font-bold" primary={kr-bold-face}><media:Fallback font={kr-reg-face}/></media:FontStack>
  <media:FontStack id="font-regular" primary={kr-reg-face}><media:Fallback font={kr-bold-face}/></media:FontStack>

  <media:Image id="broll1" src="./assets/beat1.jpg"/>
  <media:Image id="broll2" src="./assets/beat2.jpg"/>
  <media:Image id="broll3" src="./assets/beat3.jpg"/>
  <media:Image id="broll4" src="./assets/beat4.jpg"/>
  <media:Image id="broll5" src="./assets/beat5.jpg"/>
  <media:Audio id="voice-raw" src="./assets/narration.wav"/>
  <media:Audio id="bgm-raw" src="./assets/bgm.wav"/>

  <mediaop:Normalize id="voice-media" source={voice-raw} video="none" audio="default" span-authority="audio" clock={clock}/>
  <mediaop:Normalize id="bgm-media" source={bgm-raw} video="none" audio="default" span-authority="audio" clock={clock}/>

  <shorts:Scene id="scene"
    timeline={animation.timeline}
    within={canvas.bounds}
    during={animation.window}
    font-bold={font-bold}
    font-regular={font-regular}
    bg-beat1={broll1}
    bg-beat2={broll2}
    bg-beat3={broll3}
    bg-beat4={broll4}
    bg-beat5={broll5}
    beat-compare={animation.beat-compare}
    beat-steps={animation.beat-steps}
    beat-rule={animation.beat-rule}
    beat-closing={animation.beat-closing}
    theme-mode="senior-editorial"
    channel-name="숨은지원금 · 정책·연금 연구소"
    category-pill="2026 주택연금 · 노후 연금 설계"
    accent-color="rgba(16,185,129,0.22)"
    scene1-caption="SCENE 01 · 2026 주택연금 공시가 12억 기준"
    scene2-caption="SCENE 02 · 일반형 vs 우대형 수령액 격차"
    scene3-caption="SCENE 03 · 한국주택금융공사 3단계 조회법"
    scene4-caption="SCENE 04 · 우대형 최대 20% 증액 기준선"
    scene5-caption="SCENE 05 · 가입 전 필수 3대 체크리스트"
    hook-badge="부부 중 1명 만 55세 이상 핵심 기준"
    hook-stat="+20%"
    hook-unit="우대형 주택연금 선택 시 월 수령액 최대 증액 폭"
    hook-title="내 집으로 매달 평생 받는 연금
일반형 vs 우대형 얼마 차이 날까?"
    hook-sub="공시가격 12억 원 이하 가입 문턱 완화와 시세 2억 5천만 원 미만 우대형 조건 핵심 비교"
    compare-title="일반형 vs 우대형 주택연금 구조 비교"
    wrong-label="일반형 주택연금 기본 조회"
    wrong-title="우대 요건 미확인 시 기본 지급률 적용"
    wrong-desc="1주택 기초연금 수급자임에도 일반형으로만 단순 계산하면 매달 받을 수 있는 추가 증액분을 놓치기 쉽습니다."
    right-label="우대형 주택연금 · 최대 20% 증액"
    right-title="시가 2.5억 미만 + 기초연금 수급 1주택"
    right-desc="우대형 요건을 충족하면 동일 연령·주택가격 대비 매달 수령하는 연금 지급액이 최대 20%까지 늘어납니다."
    steps-title="예상 월 수령액 1분 계산 3단계"
    rule-badge="가입 전 반드시 확인할 평생 지급 보장 규칙"
    rule-title="집값이 내려가도 첫 수령액 그대로,
남으면 자녀에게 상속됩니다"
    rule-desc="국가가 평생 지급을 보증하므로 향후 주택 가격 하락에 따른 연금 삭감 위험이 없으며, 연금 총액이 집값보다 적으면 차액은 상속인에게 돌아갑니다."
    rule-pill1="가입 기준: 부부 중 1명 만 55세 이상 · 공시가 12억 이하"
    rule-pill2="우대 기준: 시세 2.5억 미만 1주택 + 기초연금 수급자"
    closing-title="주택연금 신청 전 3대 핵심 요약"
    check1="공시가격 12억 원 이하 여부 (다주택 합산 기준 포함)"
    check2="시세 2억 5천만 원 미만 시 우대형 최대 20% 증액 체크"
    check3="부부 중 연소자 나이와 현재 시세로 예상연금 사전 시뮬레이션"
    cta-banner="채널 게시물 탭에서 연령별·주택가격별 상세 수령액 비교표를 확인하세요">
    <shorts:Step id="step-1" badge="STEP 01" title="한국주택금융공사 홈페이지·앱 접속" detail="주택연금 메뉴 → 예상연금조회 계산기 화면 열기" at={animation.step-1-at}/>
    <shorts:Step id="step-2" badge="STEP 02" title="부부 생년월일 및 주택 시세 입력" detail="연소자 기준 연령과 한국부동산원·KB 시세 자동 불러오기" at={animation.step-2-at}/>
    <shorts:Step id="step-3" badge="STEP 03" title="일반형·우대형 및 지급방식 비교" detail="종신지급방식·정액형 기준으로 우대형 해당 여부 즉시 대조" at={animation.step-3-at}/>
    <shorts:Caption id="cap-1" highlight="HOOK · 평생 거주하며 매달 받는 주택연금" text="평생 살던 내 집에 그대로 거주하면서 매달 따박따박 월급처럼 연금을 받을 수 있다면 얼마가 나올까요?" at={animation.cap-0-at}/>
    <shorts:Caption id="cap-2" highlight="CORE · 공시가격 12억 이하 &amp; 우대형 최대 20% 증액" text="2026년 주택연금은 공시가격 12억 원 이하까지 문턱이 넓어졌고, 우대형 요건에 해당하면 월 수령액이 최대 20퍼센트까지 늘어납니다." at={animation.cap-1-at}/>
    <shorts:Caption id="cap-3" highlight="COMPARE · 일반형 단순 계산의 함정" text="많은 분들이 내 집 시세만 넣고 일반형으로 계산해 본 뒤 예상보다 적다며 포기하곤 합니다." at={animation.cap-2-at}/>
    <shorts:Caption id="cap-4" highlight="BENEFIT · 우대형 주택연금 증액 조건" text="하지만 부부 기준 1주택자이면서 기초연금 수급자이고 주택 시세가 2억 5천만 원 미만이라면 우대형으로 훨씬 높은 월 지급액을 적용받습니다." at={animation.cap-3-at}/>
    <shorts:Caption id="cap-5" highlight="STEP 01 · 한국주택금융공사 예상연금조회 접속" text="내 예상 수령액 확인 첫 단계는 한국주택금융공사 홈페이지나 스마트주택금융 앱에서 예상연금조회 메뉴를 여는 것입니다." at={animation.cap-4-at}/>
    <shorts:Caption id="cap-6" highlight="STEP 02 · 연소자 연령 및 KB·한국부동산원 시세 입력" text="둘째, 부부 중 나이가 더 적은 분의 생년월일과 현재 아파트나 주택의 시세를 순서대로 입력합니다." at={animation.cap-5-at}/>
    <shorts:Caption id="cap-7" highlight="STEP 03 · 종신 정액형 및 우대형 비교" text="셋째, 지급 유형을 종신 정액형으로 두고 일반형과 우대형 버튼을 번갈아 눌러 월 수령액 차이를 바로 비교합니다." at={animation.cap-6-at}/>
    <shorts:Caption id="cap-8" highlight="RULE · 집값 하락 무관 평생 동일 금액 보장" text="특히 주택연금은 가입 후 집값이 떨어져도 처음 결정된 월 수령액이 평생 깎이지 않고 그대로 지급됩니다." at={animation.cap-7-at}/>
    <shorts:Caption id="cap-9" highlight="SAFETY · 정산 시 남는 차액 상속, 부족분 미청구" text="반대로 나중에 집값이 남으면 자녀에게 상속되고, 연금을 더 많이 받았더라도 상속인에게 부족분을 절대 청구하지 않습니다." at={animation.cap-8-at}/>
    <shorts:Caption id="cap-10" highlight="FINAL · 3대 핵심 요약 &amp; 연령별 수령액표 확인" text="공시가 12억 기준, 우대형 20퍼센트 증액, 연소자 연령 기준 세 가지를 꼭 기억하시고 채널 게시물 탭에서 연령별 비교표를 확인해 보세요." at={animation.cap-9-at}/>
  </shorts:Scene>

  <audio:Track id="voice-track" timeline={animation.timeline}>
    <audio:Clip id="voice-clip" source={voice-media.media} during={animation.window} gain="1"/>
  </audio:Track>

  <audio:Track id="bgm-track" timeline={animation.timeline}>
    <audio:Clip id="bgm-clip" source={bgm-media.media} during={animation.window} gain="0.06" fade-in="15f" fade-out="25f"/>
  </audio:Track>

  <film:Film id="main" canvas={canvas.canvas} timeline={animation.timeline} appearance={style.film.main}>
    <film:Track source={scene.visual}/>
    <film:Track source={voice-track.audio}/>
    <film:Track source={bgm-track.audio}/>
  </film:Film>

  <html:Video id="final" composition={main.composition} timeline={animation.timeline}/>
</svml>
