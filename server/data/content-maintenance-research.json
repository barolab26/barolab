  "page:https://reservation-guide.com/%EB%A1%9C%EC%A0%A0%ED%83%9D%EB%B0%B0-%EC%8B%A4%EC%8B%9C%EA%B0%84-%EB%B0%B0%EC%86%A1%EC%A1%B0%ED%9A%8C-%EC%84%9C%EB%B9%84%EC%8A%A4-%EC%95%88%EB%82%B4/": {
    "url": "https://reservation-guide.com/%EB%A1%9C%EC%A0%A0%ED%83%9D%EB%B0%B0-%EC%8B%A4%EC%8B%9C%EA%B0%84-%EB%B0%B0%EC%86%A1%EC%A1%B0%ED%9A%8C-%EC%84%9C%EB%B9%84%EC%8A%A4-%EC%95%88%EB%82%B4/",
